# SOLO NODO SERVIDOR CENTRAL (EDDI MICHAEL) - .env NO se sube a Git.
# Rodrigo y Fernanda NO deben crear ni llenar este archivo: sin .env el sistema
# opera en modo local seguro (SIN_CREDENCIALES en alertas_telegram.json y
# BotComandos inactivo), sin tocar el bot real ni causar errores 409.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionales (exclusivos del servidor de Eddi Michael)
# ADMIN_CHAT_IDS=111111,222222       # otros administradores autorizados para comandos
# API_KEYS=clave-agente,clave-admin  # si se define, exige cabecera X-API-Key
# BOT_COMANDOS=1                     # 0 desactiva los comandos del bot
# BITACORA_HOST=0.0.0.0
# BITACORA_PORT=8443
# UMBRAL_ABIERTAS=3
# TELEGRAM_TIMEOUT=5
